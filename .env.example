# Copiez ce fichier vers .env puis renseignez les valeurs de votre projet Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé publique du SDK RevenueCat Web Billing (RevenueCat → API keys → SDK API keys).
# Elle est faite pour vivre dans le front : elle ne permet que de lire le
# catalogue et de démarrer un achat.
#
# Bac à sable — aucun paiement réel n'est encaissé. C'est aussi la valeur par
# défaut du code si la variable n'est pas renseignée.
VITE_REVENUECAT_CLE_PUBLIQUE=rcb_sb_GMMCEAyVBmaXZZrFpcYBDlqLT
#
# Production — à décommenter (et à mettre dans les variables Vercel) le jour
# de la bascule, en supprimant la ligne de bac à sable ci-dessus.
# VITE_REVENUECAT_CLE_PUBLIQUE=rcb_xKKjJsVkxsccNxJoRzKkonSgHhEX

# Portail client RevenueCat, utilisé si le webhook n'a pas transmis
# l'URL propre au compte (voir docs/abonnement.md)
VITE_REVENUECAT_LIEN_PORTAIL=https://portal.rev.cat/xxxxxxxx
