# Copiez ce fichier vers .env puis renseignez les valeurs de votre projet Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Web Purchase Link RevenueCat (voir docs/abonnement.md)
VITE_REVENUECAT_LIEN_ACHAT=https://pay.rev.cat/xxxxxxxx

# Portail client RevenueCat, utilisé si le webhook n'a pas transmis
# l'URL propre au compte (voir docs/abonnement.md)
VITE_REVENUECAT_LIEN_PORTAIL=https://portal.rev.cat/xxxxxxxx
